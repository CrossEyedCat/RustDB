# Rust
/target/
/target*/
**/*.rs.bk

# IDE
.vs/
.vscode/
.cursor/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
# ...except checked-in test fixtures: the blanket `*.log` above silently kept the txn/server logs
# of tests/fixtures/tpcc_validation out of the repo, so validate_tpcc_run's fixture test could
# never pass on a fresh clone.
!tests/fixtures/**/*.log
/logs/
/test_logs/
/profile-out/
/pgbench-out/

# TPC-C / bench artifacts (local, CI downloads, A/B extracts — never commit)
/tpcc-out/
/tpcc-local-out/
/tpcc-artifacts*/
/tpcc-artifacts-run*/
/tpcc-ci-*/
tpcc-ci-*/
/_tpcc/
/_tpcc*/
_tpcc/
_tpcc*/
/_bench*/
_bench*/
*_bench_*
server.der
data/ci_tpcc_idx_verify/
data/ci_tpcc_idx_verify2/
/sandbox-data/

# Python
__pycache__/
*.py[cod]

# Database files
*.db
*.db-*

# Temporary files
*.tmp
*.temp
